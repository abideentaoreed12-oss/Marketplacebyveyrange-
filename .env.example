# Supabase project settings (use the publishable key, never a secret key in browser code)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets, when a reviewed server operation actually requires them.
# Never prefix server secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:3000

# Algolia product search. Use a restricted indexing key, never an Admin API key.
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_WRITE_API_KEY=
